# Whitelist-only .gitignore: track ONLY root docs and published Nexus Mods folders
*

# Root repository files
!.gitignore
!README.md
!README_EN.md

# Track published Mod directories
!PBZDetailedWeaponDesc/
!PBZDetailedWeaponDesc/**
!PBZDetailedWeaponDesc_Dynamic/
!PBZDetailedWeaponDesc_Dynamic/**
!PBZEnemyStatusBars/
!PBZEnemyStatusBars/**
!PBZExtraAccessorySlots/
!PBZExtraAccessorySlots/**
!PBZWeatherControl/
!PBZWeatherControl/**
!PBZFreeRevert/
!PBZFreeRevert/**

# Exclude temporary/local runtime files even inside tracked folders
*.log
*.zip
*.7z
*.rar
*.tmp
.DS_Store
Thumbs.db
